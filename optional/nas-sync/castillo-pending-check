#!/usr/bin/env python3

import argparse
import configparser
import json
import os
import sys


CONFIG_FILE = "/etc/castillo-player/castillo.ini"


def fail(message, code=1):
    print(
        json.dumps(
            {
                "ok": False,
                "error": message,
            },
            ensure_ascii=False,
        ),
        file=sys.stderr,
    )

    sys.exit(code)


def clean_ini_value(value):
    value = str(value).strip()

    if (
        len(value) >= 2
        and value[0] == value[-1]
        and value[0] in ('"', "'")
    ):
        value = value[1:-1].strip()

    return value


def config_boolean(value):
    value = clean_ini_value(
        value
    ).casefold()

    if value in {
        "1",
        "true",
        "yes",
        "on",
    }:
        return True

    if value in {
        "0",
        "false",
        "no",
        "off",
    }:
        return False

    fail(
        "Valor inválido para nas.enabled.",
        4,
    )


def validate_config_file():
    if not os.path.isfile(
        CONFIG_FILE
    ):
        fail(
            "No existe la configuración de Castillo Player.",
            2,
        )

    try:
        stat_info = os.stat(
            CONFIG_FILE
        )

    except OSError as error:
        fail(
            f"No fue posible revisar la configuración: {error}",
            2,
        )

    if stat_info.st_uid != 0:
        fail(
            "La configuración de Castillo Player debe pertenecer a root.",
            2,
        )

    if stat_info.st_mode & 0o022:
        fail(
            "La configuración de Castillo Player no puede ser escribible "
            "por grupo u otros usuarios.",
            2,
        )


def load_castillo_config():
    validate_config_file()

    parser = configparser.ConfigParser(
        interpolation=None
    )

    try:
        loaded = parser.read(
            CONFIG_FILE,
            encoding="utf-8",
        )

    except (
        configparser.Error,
        OSError,
    ) as error:
        fail(
            f"No fue posible leer la configuración: {error}",
            3,
        )

    if not loaded:
        fail(
            "No fue posible cargar la configuración de Castillo Player.",
            3,
        )

    try:
        local_root = clean_ini_value(
            parser["core"]["library_root"]
        )

        state_dir = clean_ini_value(
            parser["core"]["state_dir"]
        )

        nas_enabled = config_boolean(
            parser["nas"]["enabled"]
        )

        nas_root = clean_ini_value(
            parser["nas"]["readonly_root"]
        )

    except KeyError as error:
        fail(
            f"Falta configuración requerida: {error}",
            4,
        )

    if not nas_enabled:
        fail(
            "El módulo NAS está deshabilitado.",
            5,
        )

    for name, value in (
        ("library_root", local_root),
        ("state_dir", state_dir),
        ("nas.readonly_root", nas_root),
    ):
        if (
            not value
            or not os.path.isabs(
                value
            )
        ):
            fail(
                f"{name} debe ser una ruta absoluta.",
                6,
            )

    local_root = os.path.realpath(
        local_root
    )

    state_dir = os.path.realpath(
        state_dir
    )

    nas_root = os.path.realpath(
        nas_root
    )

    if local_root == os.path.sep:
        fail(
            "library_root no puede ser la raíz del sistema.",
            7,
        )

    if state_dir == os.path.sep:
        fail(
            "state_dir no puede ser la raíz del sistema.",
            7,
        )

    if nas_root == os.path.sep:
        fail(
            "nas.readonly_root no puede ser la raíz del sistema.",
            7,
        )

    if not os.path.isdir(
        local_root
    ):
        fail(
            "No existe la biblioteca local configurada.",
            8,
        )

    state_file = os.path.join(
        state_dir,
        "pending-changes.json",
    )

    return (
        local_root,
        nas_root,
        state_file,
    )


def path_inside_root(
    path,
    root,
):
    try:
        return (
            os.path.commonpath(
                [
                    path,
                    root,
                ]
            )
            == root
        )

    except ValueError:
        return False


LOCAL_ROOT, NAS_ROOT, STATE_FILE = (
    load_castillo_config()
)


def file_info(path):
    stat = os.stat(path)

    return {
        "size": int(stat.st_size),
        "mtime_ns": int(stat.st_mtime_ns),
    }


def load_state():
    if not os.path.isfile(
        STATE_FILE
    ):
        return {
            "version": 1,
            "items": {},
        }

    try:
        with open(
            STATE_FILE,
            "r",
            encoding="utf-8",
        ) as handle:
            state = json.load(
                handle
            )

    except Exception as error:
        fail(
            f"No fue posible leer pendientes: {error}",
            20,
        )


    if not isinstance(
        state,
        dict,
    ):
        fail(
            "Registro de pendientes inválido.",
            21,
        )


    if not isinstance(
        state.get("items"),
        dict,
    ):
        state["items"] = {}


    return state


def safe_relative(relative):
    relative = str(
        relative or ""
    ).strip()


    if not relative:
        fail(
            "Ruta relativa vacía.",
            30,
        )


    normalized = os.path.normpath(
        relative
    )


    if (
        normalized == ".."
        or normalized.startswith(
            "../"
        )
        or os.path.isabs(
            normalized
        )
    ):
        fail(
            "Ruta relativa no autorizada.",
            31,
        )


    return normalized


def current_nas_state(relative):
    if not os.path.ismount(
        NAS_ROOT
    ):
        return {
            "status": "unavailable",
        }


    target = os.path.normpath(
        os.path.join(
            NAS_ROOT,
            relative,
        )
    )


    nas_root_real = os.path.realpath(
        NAS_ROOT
    )

    parent_real = os.path.realpath(
        os.path.dirname(
            target
        )
    )


    if not path_inside_root(
        parent_real,
        nas_root_real,
    ):
        return {
            "status": "invalid",
        }


    if not os.path.isfile(
        target
    ):
        return {
            "status": "missing",
        }


    info = file_info(
        target
    )


    return {
        "status": "present",
        "size": info["size"],
        "mtime_ns": info["mtime_ns"],
    }


def check_item(item):
    relative = safe_relative(
        item.get(
            "relative_path",
            ""
        )
    )


    local = os.path.join(
        LOCAL_ROOT,
        relative,
    )


    result = {
        "relative_path":
            relative,

        "types":
            item.get(
                "types",
                []
            ),

        "audio_file":
            item.get(
                "audio_file",
                ""
            ),

        "baseline":
            item.get(
                "nas_baseline",
                {
                    "status":
                        "unavailable"
                }
            ),
    }


    #
    # Comprobar archivo local.
    #
    if not os.path.isfile(
        local
    ):
        result.update({
            "status":
                "blocked",

            "reason":
                "local_missing",

            "message":
                "El archivo local ya no existe.",
        })

        return result


    current_local = file_info(
        local
    )


    result["current_local"] = (
        current_local
    )


    registered_local = item.get(
        "local",
        {}
    )


    #
    # Si cambió DESPUÉS del último
    # registro de Castillo, no debemos
    # sincronizar algo distinto de lo
    # que el usuario revisó.
    #
    if (
        registered_local
        and (
            int(
                registered_local.get(
                    "size",
                    -1
                )
            )
            != current_local["size"]
            or int(
                registered_local.get(
                    "mtime_ns",
                    -1
                )
            )
            != current_local["mtime_ns"]
        )
    ):
        result.update({
            "status":
                "blocked",

            "reason":
                "local_changed",

            "message":
                "El archivo local cambió después de registrarse.",
        })

        return result


    baseline = result[
        "baseline"
    ]


    current_nas = (
        current_nas_state(
            relative
        )
    )


    result["current_nas"] = (
        current_nas
    )


    #
    # NAS no accesible.
    #
    if (
        current_nas.get(
            "status"
        )
        == "unavailable"
    ):
        result.update({
            "status":
                "blocked",

            "reason":
                "nas_unavailable",

            "message":
                "El NAS no está disponible.",
        })

        return result


    if (
        current_nas.get(
            "status"
        )
        == "invalid"
    ):
        result.update({
            "status":
                "blocked",

            "reason":
                "invalid_path",

            "message":
                "La ruta NAS no es válida.",
        })

        return result


    baseline_status = (
        baseline.get(
            "status"
        )
    )


    current_status = (
        current_nas.get(
            "status"
        )
    )


    #
    # No pudimos tomar referencia del NAS
    # cuando comenzó la edición.
    #
    if baseline_status == "unavailable":
        result.update({
            "status":
                "blocked",

            "reason":
                "baseline_unavailable",

            "message":
                "No existe una referencia inicial válida del NAS.",
        })

        return result


    #
    # El archivo NO existía originalmente.
    #
    if baseline_status == "missing":

        if current_status == "missing":
            result.update({
                "status":
                    "ready",

                "reason":
                    "new_file",

                "message":
                    "Archivo nuevo para el NAS.",
            })

            return result


        result.update({
            "status":
                "conflict",

            "reason":
                "appeared_on_nas",

            "message":
                "El archivo apareció en el NAS después de iniciar la edición.",
        })

        return result


    #
    # El archivo existía cuando comenzó
    # la modificación local.
    #
    if baseline_status == "present":

        if current_status == "missing":
            result.update({
                "status":
                    "conflict",

                "reason":
                    "deleted_on_nas",

                "message":
                    "El archivo fue eliminado del NAS después de iniciar la edición.",
            })

            return result


        same_size = (
            int(
                baseline.get(
                    "size",
                    -1
                )
            )
            ==
            int(
                current_nas.get(
                    "size",
                    -2
                )
            )
        )


        same_mtime = (
            int(
                baseline.get(
                    "mtime_ns",
                    -1
                )
            )
            ==
            int(
                current_nas.get(
                    "mtime_ns",
                    -2
                )
            )
        )


        if (
            same_size
            and same_mtime
        ):
            result.update({
                "status":
                    "ready",

                "reason":
                    "unchanged",

                "message":
                    "El archivo del NAS no ha cambiado.",
            })

            return result


        result.update({
            "status":
                "conflict",

            "reason":
                "nas_changed",

            "message":
                "El archivo del NAS cambió después de iniciar la edición.",
        })

        return result


    result.update({
        "status":
            "blocked",

        "reason":
            "invalid_baseline",

        "message":
            "La referencia inicial del NAS no es válida.",
    })


    return result


parser = argparse.ArgumentParser()

parser.add_argument(
    "--relative",
    action="append",
    default=[],
)

args = parser.parse_args()


state = load_state()

items = state[
    "items"
]


requested = [
    safe_relative(
        value
    )
    for value in args.relative
]


if requested:
    selected = []

    for relative in requested:

        item = items.get(
            relative
        )


        if item is None:
            fail(
                f"El archivo no está pendiente: {relative}",
                40,
            )


        selected.append(
            item
        )

else:
    selected = list(
        items.values()
    )


results = [
    check_item(
        item
    )
    for item in selected
]


ready = sum(
    1
    for item in results
    if item["status"] == "ready"
)

conflicts = sum(
    1
    for item in results
    if item["status"] == "conflict"
)

blocked = sum(
    1
    for item in results
    if item["status"] == "blocked"
)


print(
    json.dumps(
        {
            "ok": True,

            "items":
                results,

            "count":
                len(results),

            "ready":
                ready,

            "conflicts":
                conflicts,

            "blocked":
                blocked,

            "can_sync":
                (
                    len(results) > 0
                    and conflicts == 0
                    and blocked == 0
                ),
        },
        ensure_ascii=False,
    )
)
